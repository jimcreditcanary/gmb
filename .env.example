# Copy to .env.local for local dev. Everything is optional: the site builds and runs with none of these set.
NEXT_PUBLIC_SITE_ENV=            # "production" only on the live domain → enables indexing, robots allow, sitemap. Anything else = noindex everywhere.
NEXT_PUBLIC_GTM_ID=              # GTM-NQCV3C4 once access is confirmed; container loads only after consent (Consent Mode v2)
MAILCHIMP_API_KEY=               # with MAILCHIMP_AUDIENCE_ID switches the newsletter route to the Marketing API; otherwise it forwards to the public list-manage endpoint
MAILCHIMP_AUDIENCE_ID=a34de2255e
RESEND_API_KEY=                  # with CONTACT_TO delivers contact-form submissions by email; otherwise they are logged
CONTACT_TO=
CONTACT_FROM=website@gmbcreditunion.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=  # optional Cloudflare Turnstile on forms
TURNSTILE_SECRET_KEY=
