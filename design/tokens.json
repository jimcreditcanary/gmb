{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "GMB Credit Union design tokens. Three layers: primitive (raw brand values) → semantic (purpose) → component. Generated to app/styles/tokens.css with `pnpm tokens`. Brand sources: logo orange #FF4800 (public/theme/images/logo.png), navy #102C45 and the Menca faces from the original theme; the four pastel tints are kept as section tones.",
  "primitive": {
    "color": {
      "orange": {
        "50": { "$value": "#FFF3EE", "$type": "color" },
        "100": { "$value": "#FFE2D6", "$type": "color" },
        "200": { "$value": "#FFC4AD", "$type": "color" },
        "300": { "$value": "#FF9A73", "$type": "color" },
        "400": { "$value": "#FF6F3A", "$type": "color" },
        "500": { "$value": "#FF4800", "$type": "color", "$description": "Logo orange. 3.1:1 on white: accents and large type only." },
        "600": { "$value": "#CC4512", "$type": "color", "$description": "Hue-matched AA orange, 4.7:1 on white: buttons, links, small text." },
        "700": { "$value": "#A8380E", "$type": "color", "$description": "Hover / active." },
        "800": { "$value": "#7E2A0A", "$type": "color" }
      },
      "navy": {
        "50": { "$value": "#EEF2F6", "$type": "color" },
        "100": { "$value": "#D9E1EA", "$type": "color" },
        "200": { "$value": "#B3C3D4", "$type": "color" },
        "300": { "$value": "#7F97B0", "$type": "color" },
        "400": { "$value": "#4F6B88", "$type": "color" },
        "500": { "$value": "#2B4866", "$type": "color" },
        "600": { "$value": "#1C3A57", "$type": "color" },
        "700": { "$value": "#102C45", "$type": "color", "$description": "Brand navy: headings, body text, footer." },
        "800": { "$value": "#0B1F32", "$type": "color" },
        "900": { "$value": "#07141F", "$type": "color" }
      },
      "neutral": {
        "0": { "$value": "#FFFFFF", "$type": "color" },
        "50": { "$value": "#F7F8FA", "$type": "color" },
        "100": { "$value": "#EFF1F4", "$type": "color" },
        "200": { "$value": "#E1E5EA", "$type": "color" },
        "300": { "$value": "#CBD2DA", "$type": "color" },
        "400": { "$value": "#98A3B0", "$type": "color" },
        "500": { "$value": "#6B7785", "$type": "color" },
        "600": { "$value": "#4F5B68", "$type": "color" },
        "700": { "$value": "#3A4550", "$type": "color" }
      },
      "tint": {
        "lilac": { "$value": "#DECEF9", "$type": "color" },
        "lilac-deep": { "$value": "#4A2B7F", "$type": "color" },
        "blue": { "$value": "#CFF4FB", "$type": "color" },
        "green": { "$value": "#8CD697", "$type": "color" },
        "yellow": { "$value": "#F6C757", "$type": "color" },
        "cream": { "$value": "#FFFFF4", "$type": "color" }
      },
      "status": {
        "success": { "$value": "#1E7B4B", "$type": "color" },
        "warning": { "$value": "#B26A00", "$type": "color" },
        "error": { "$value": "#B3261E", "$type": "color" },
        "info": { "$value": "#1C3A57", "$type": "color" }
      },
      "trustpilot": { "$value": "#00B67A", "$type": "color" }
    },
    "font": {
      "display": { "$value": "var(--font-menca-bold), system-ui, sans-serif", "$type": "fontFamily" },
      "body": { "$value": "var(--font-menca-medium), system-ui, sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "ui-monospace, SFMono-Regular, Menlo, monospace", "$type": "fontFamily" }
    },
    "fontSize": {
      "xs": { "$value": "0.75rem", "$type": "dimension" },
      "sm": { "$value": "0.875rem", "$type": "dimension" },
      "base": { "$value": "1rem", "$type": "dimension" },
      "lg": { "$value": "1.125rem", "$type": "dimension" },
      "xl": { "$value": "1.25rem", "$type": "dimension" },
      "2xl": { "$value": "1.5rem", "$type": "dimension" },
      "3xl": { "$value": "1.875rem", "$type": "dimension" },
      "4xl": { "$value": "2.25rem", "$type": "dimension" },
      "5xl": { "$value": "2.75rem", "$type": "dimension" },
      "6xl": { "$value": "3.5rem", "$type": "dimension" }
    },
    "lineHeight": {
      "none": { "$value": "1", "$type": "number" },
      "tight": { "$value": "1.1", "$type": "number" },
      "snug": { "$value": "1.25", "$type": "number" },
      "normal": { "$value": "1.5", "$type": "number" },
      "relaxed": { "$value": "1.6", "$type": "number" }
    },
    "letterSpacing": {
      "tight": { "$value": "-0.02em", "$type": "dimension" },
      "normal": { "$value": "0", "$type": "dimension" },
      "wide": { "$value": "0.04em", "$type": "dimension" }
    },
    "spacing": {
      "0": { "$value": "0", "$type": "dimension" },
      "1": { "$value": "0.25rem", "$type": "dimension" },
      "2": { "$value": "0.5rem", "$type": "dimension" },
      "3": { "$value": "0.75rem", "$type": "dimension" },
      "4": { "$value": "1rem", "$type": "dimension" },
      "5": { "$value": "1.25rem", "$type": "dimension" },
      "6": { "$value": "1.5rem", "$type": "dimension" },
      "8": { "$value": "2rem", "$type": "dimension" },
      "10": { "$value": "2.5rem", "$type": "dimension" },
      "12": { "$value": "3rem", "$type": "dimension" },
      "16": { "$value": "4rem", "$type": "dimension" },
      "20": { "$value": "5rem", "$type": "dimension" },
      "24": { "$value": "6rem", "$type": "dimension" },
      "32": { "$value": "8rem", "$type": "dimension" }
    },
    "radius": {
      "none": { "$value": "0", "$type": "dimension" },
      "sm": { "$value": "0.5rem", "$type": "dimension" },
      "md": { "$value": "0.75rem", "$type": "dimension" },
      "lg": { "$value": "1rem", "$type": "dimension" },
      "xl": { "$value": "1.5rem", "$type": "dimension" },
      "full": { "$value": "9999px", "$type": "dimension" }
    },
    "shadow": {
      "none": { "$value": "none", "$type": "shadow" },
      "sm": { "$value": "0 1px 2px 0 rgb(16 44 69 / 0.06)", "$type": "shadow" },
      "md": { "$value": "0 4px 12px -2px rgb(16 44 69 / 0.08), 0 1px 3px rgb(16 44 69 / 0.05)", "$type": "shadow" },
      "lg": { "$value": "0 12px 32px -8px rgb(16 44 69 / 0.14), 0 2px 6px rgb(16 44 69 / 0.06)", "$type": "shadow" }
    },
    "duration": {
      "fast": { "$value": "150ms", "$type": "duration" },
      "base": { "$value": "200ms", "$type": "duration" },
      "slow": { "$value": "400ms", "$type": "duration" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.2, 0.8, 0.2, 1)", "$type": "cubicBezier" },
      "out": { "$value": "cubic-bezier(0.16, 1, 0.3, 1)", "$type": "cubicBezier" }
    },
    "size": {
      "container": { "$value": "75rem", "$type": "dimension", "$description": "1200px content width" },
      "container-wide": { "$value": "87.5rem", "$type": "dimension", "$description": "1400px for full-bleed art" },
      "measure": { "$value": "65ch", "$type": "dimension" },
      "nav-height": { "$value": "4.5rem", "$type": "dimension" }
    }
  },
  "semantic": {
    "color": {
      "surface": { "$value": "{primitive.color.neutral.0}", "$type": "color" },
      "surface-subtle": { "$value": "{primitive.color.neutral.50}", "$type": "color" },
      "surface-muted": { "$value": "{primitive.color.neutral.100}", "$type": "color" },
      "surface-inverse": { "$value": "{primitive.color.navy.700}", "$type": "color" },
      "surface-brand": { "$value": "{primitive.color.orange.600}", "$type": "color" },
      "surface-brand-soft": { "$value": "{primitive.color.orange.50}", "$type": "color" },
      "ink": { "$value": "{primitive.color.navy.700}", "$type": "color" },
      "ink-muted": { "$value": "{primitive.color.neutral.700}", "$type": "color", "$description": "Secondary copy. Neutral 700 so it still passes AA on the four brand tints (5.7:1 on green)." },
      "ink-subtle": { "$value": "{primitive.color.neutral.600}", "$type": "color", "$description": "Placeholders and captions on white only." },
      "ink-inverse": { "$value": "{primitive.color.neutral.0}", "$type": "color" },
      "ink-inverse-muted": { "$value": "{primitive.color.navy.200}", "$type": "color" },
      "brand": { "$value": "{primitive.color.orange.500}", "$type": "color", "$description": "Decorative: underline marks, icons, large display accents." },
      "brand-strong": { "$value": "{primitive.color.orange.600}", "$type": "color", "$description": "Actionable: buttons, links, small text." },
      "brand-hover": { "$value": "{primitive.color.orange.700}", "$type": "color" },
      "brand-soft": { "$value": "{primitive.color.orange.100}", "$type": "color" },
      "link": { "$value": "{primitive.color.orange.600}", "$type": "color" },
      "link-hover": { "$value": "{primitive.color.navy.700}", "$type": "color" },
      "border": { "$value": "{primitive.color.neutral.200}", "$type": "color" },
      "border-strong": { "$value": "{primitive.color.neutral.300}", "$type": "color" },
      "ring": { "$value": "{primitive.color.navy.700}", "$type": "color" },
      "tone-loans": { "$value": "{primitive.color.tint.green}", "$type": "color" },
      "tone-savings": { "$value": "{primitive.color.tint.blue}", "$type": "color" },
      "tone-about": { "$value": "{primitive.color.tint.lilac}", "$type": "color" },
      "tone-resources": { "$value": "{primitive.color.tint.yellow}", "$type": "color" },
      "tone-deep": { "$value": "{primitive.color.tint.lilac-deep}", "$type": "color" },
      "success": { "$value": "{primitive.color.status.success}", "$type": "color" },
      "warning": { "$value": "{primitive.color.status.warning}", "$type": "color" },
      "error": { "$value": "{primitive.color.status.error}", "$type": "color" }
    },
    "typography": {
      "display": { "$value": "clamp(2.5rem, 1.6rem + 3vw, 3.5rem)", "$type": "dimension", "$description": "Home hero H1" },
      "h1": { "$value": "clamp(2.25rem, 1.5rem + 2.4vw, 3rem)", "$type": "dimension" },
      "h2": { "$value": "clamp(1.75rem, 1.3rem + 1.4vw, 2.25rem)", "$type": "dimension" },
      "h3": { "$value": "1.375rem", "$type": "dimension" },
      "h4": { "$value": "1.125rem", "$type": "dimension" },
      "lead": { "$value": "1.25rem", "$type": "dimension" },
      "body": { "$value": "1.0625rem", "$type": "dimension" },
      "small": { "$value": "0.9375rem", "$type": "dimension" },
      "caption": { "$value": "0.8125rem", "$type": "dimension" },
      "leading-heading": { "$value": "{primitive.lineHeight.tight}", "$type": "number" },
      "leading-body": { "$value": "{primitive.lineHeight.relaxed}", "$type": "number" },
      "measure": { "$value": "{primitive.size.measure}", "$type": "dimension" }
    },
    "spacing": {
      "section": { "$value": "clamp(3rem, 2rem + 4vw, 6rem)", "$type": "dimension", "$description": "Vertical padding of a page section" },
      "section-tight": { "$value": "clamp(2rem, 1.5rem + 2vw, 3.5rem)", "$type": "dimension" },
      "block": { "$value": "{primitive.spacing.8}", "$type": "dimension", "$description": "Gap between blocks inside a section" },
      "stack": { "$value": "{primitive.spacing.4}", "$type": "dimension", "$description": "Gap between heading, paragraph, button" },
      "gutter": { "$value": "{primitive.spacing.6}", "$type": "dimension" },
      "page-inline": { "$value": "clamp(1rem, 0.5rem + 2.5vw, 2.5rem)", "$type": "dimension" }
    },
    "radius": {
      "control": { "$value": "{primitive.radius.full}", "$type": "dimension", "$description": "Buttons and pills" },
      "field": { "$value": "{primitive.radius.md}", "$type": "dimension", "$description": "Inputs" },
      "card": { "$value": "{primitive.radius.lg}", "$type": "dimension" },
      "panel": { "$value": "{primitive.radius.xl}", "$type": "dimension", "$description": "Hero and large tinted panels" },
      "media": { "$value": "{primitive.radius.lg}", "$type": "dimension" }
    },
    "motion": {
      "duration": { "$value": "{primitive.duration.base}", "$type": "duration" },
      "duration-slow": { "$value": "{primitive.duration.slow}", "$type": "duration" },
      "easing": { "$value": "{primitive.easing.standard}", "$type": "cubicBezier" }
    }
  },
  "component": {
    "button": {
      "bg": { "$value": "{semantic.color.brand-strong}", "$type": "color" },
      "fg": { "$value": "{semantic.color.ink-inverse}", "$type": "color" },
      "hover-bg": { "$value": "{semantic.color.brand-hover}", "$type": "color" },
      "secondary-bg": { "$value": "{semantic.color.surface}", "$type": "color" },
      "secondary-fg": { "$value": "{semantic.color.ink}", "$type": "color" },
      "secondary-border": { "$value": "{semantic.color.ink}", "$type": "color" },
      "radius": { "$value": "{semantic.radius.control}", "$type": "dimension" },
      "height-sm": { "$value": "2.5rem", "$type": "dimension" },
      "height-md": { "$value": "3rem", "$type": "dimension" },
      "height-lg": { "$value": "3.5rem", "$type": "dimension" },
      "padding-x": { "$value": "{primitive.spacing.6}", "$type": "dimension" },
      "font-size": { "$value": "{primitive.fontSize.base}", "$type": "dimension" }
    },
    "input": {
      "bg": { "$value": "{semantic.color.surface}", "$type": "color" },
      "border": { "$value": "{semantic.color.border-strong}", "$type": "color" },
      "focus-border": { "$value": "{semantic.color.ink}", "$type": "color" },
      "error-border": { "$value": "{semantic.color.error}", "$type": "color" },
      "radius": { "$value": "{semantic.radius.field}", "$type": "dimension" },
      "height": { "$value": "3rem", "$type": "dimension" },
      "padding-x": { "$value": "{primitive.spacing.4}", "$type": "dimension" }
    },
    "card": {
      "bg": { "$value": "{semantic.color.surface}", "$type": "color" },
      "border": { "$value": "{semantic.color.border}", "$type": "color" },
      "radius": { "$value": "{semantic.radius.card}", "$type": "dimension" },
      "padding": { "$value": "{primitive.spacing.6}", "$type": "dimension" },
      "shadow": { "$value": "{primitive.shadow.sm}", "$type": "shadow" },
      "hover-shadow": { "$value": "{primitive.shadow.md}", "$type": "shadow" }
    },
    "panel": {
      "radius": { "$value": "{semantic.radius.panel}", "$type": "dimension" },
      "padding": { "$value": "clamp(1.5rem, 1rem + 2vw, 3rem)", "$type": "dimension" }
    },
    "nav": {
      "height": { "$value": "{primitive.size.nav-height}", "$type": "dimension" },
      "bg": { "$value": "{semantic.color.surface}", "$type": "color" },
      "fg": { "$value": "{semantic.color.ink}", "$type": "color" },
      "border": { "$value": "{semantic.color.border}", "$type": "color" }
    },
    "footer": {
      "bg": { "$value": "{semantic.color.surface-inverse}", "$type": "color" },
      "fg": { "$value": "{semantic.color.ink-inverse}", "$type": "color" },
      "fg-muted": { "$value": "{semantic.color.ink-inverse-muted}", "$type": "color" }
    },
    "hero": {
      "radius": { "$value": "{semantic.radius.panel}", "$type": "dimension" },
      "padding-y": { "$value": "clamp(2.5rem, 1.5rem + 4vw, 5rem)", "$type": "dimension" },
      "min-height": { "$value": "28rem", "$type": "dimension" }
    }
  }
}
